{
    "name": "msstc4php/vo-base-doctrine-bridge",
    "description": "Doctrine ORM and MongoDB ODM types and embeddables for msstc4php/vo-base.",
    "type": "library",
    "license": "MIT",
    "keywords": ["value-object", "doctrine", "dbal", "orm", "mongodb-odm", "bridge", "ddd"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../vo-base",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "msstc4php/vo-base": "dev-feat/value-objects-library as 1.1.0"
    },
    "require-dev": {
        "brick/math": "^0.12 || ^0.13 || ^0.14",
        "brick/money": "^0.10",
        "deptrac/deptrac": "^3.0",
        "doctrine/dbal": "^4.4",
        "doctrine/mongodb-odm": "^2.9",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "spaze/phpstan-disallowed-calls": "^4.0"
    },
    "suggest": {
        "doctrine/dbal": "To persist scalar value objects as Doctrine ORM column types.",
        "doctrine/orm": "To map value objects and the money embeddables.",
        "doctrine/mongodb-odm": "To persist value objects with Doctrine MongoDB ODM.",
        "brick/money": "Required by BrickMoneyType and by the money embeddables' Money conversion methods."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObjectDoctrineBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObjectDoctrineBridge\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": false
        }
    }
}
